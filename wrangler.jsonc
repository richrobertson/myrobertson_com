{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myrobertson-com",
  "main": "worker.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/blog",
      "/blog/*",
      "/writing",
      "/writing/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
